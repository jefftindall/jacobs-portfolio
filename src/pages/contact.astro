---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description={`How to reach ${site.name}. Messages go to a parent-managed inbox.`}
  hideFooterCta
>
  <section class="mx-auto max-w-2xl px-6 py-16 md:py-24" aria-labelledby="contact-heading">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Get in touch</p>
    <h1 id="contact-heading" class="mt-3 font-display text-5xl text-spotlight md:text-6xl">
      Contact
    </h1>
    <p class="mt-4 max-w-2xl text-muted">
      This site does not collect visitor information in a form. Email goes to a parent-managed
      address.
    </p>

    <GlassPanel strong class="mt-10 p-6 md:p-8">
      <p class="text-sm uppercase tracking-[0.2em] text-gel">Email</p>
      <p class="mt-3 text-lg text-spotlight">
        <a class="text-gel underline underline-offset-4" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
      <p class="mt-4 text-sm text-muted">
        Please do not send personal details about other people. A parent reviews messages.
      </p>
    </GlassPanel>
  </section>
</BaseLayout>
