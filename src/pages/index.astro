---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlassPanel from '../components/GlassPanel.astro';
import CtaLink from '../components/CtaLink.astro';
import PostCard from '../components/PostCard.astro';
import { site, socials } from '../lib/site';
import { buildPersonJsonLd } from '../lib/personSchema';
import { newestFirst } from '../lib/contentSort';

const conservation = newestFirst(
  (await getCollection('conservation')).filter((item) => item.data.species),
);
const music = newestFirst(await getCollection('music'));
const news = newestFirst((await getCollection('news')).filter((n) => !n.data.draft)).slice(0, 2);

const person = buildPersonJsonLd({
  '@id': `${site.url}/#person`,
});
delete person['@context'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      description: site.description,
      publisher: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<BaseLayout description={site.description} jsonLd={jsonLd} hideFooterCta image="/images/hero.jpg">
  <Hero support="Belize manatee assessments, a friendship with a rescue dolphin, and piano pieces you can hear." />

  <section class="section-y border-b border-line" aria-labelledby="passions-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div id="passions-heading">
        <SectionHeader
          eyebrow="Passions"
          title="Two big loves"
          support="Protecting marine mammals, and making music — from Belize field work and a friendship with a rescue dolphin to piano pieces you can hear."
        />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <GlassPanel strong class="p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-gel">Ocean</p>
          <h3 class="mt-3 font-display text-3xl text-spotlight">Conservation</h3>
          <p class="mt-3 text-muted">
            Dolphins, manatees, Belize health assessments, and volunteering at Clearwater Marine
            Aquarium.
          </p>
          <ul class="mt-6 space-y-2 text-spotlight/90">
            {
              conservation.slice(0, 3).map((item) => (
                <li>
                  <a class="text-gel hover:text-spotlight" href={`/conservation/${item.id}`}>
                    {item.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <CtaLink href="/conservation">Explore conservation</CtaLink>
          </div>
        </GlassPanel>
        <GlassPanel strong class="p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-gold">Sound</p>
          <h3 class="mt-3 font-display text-3xl text-spotlight">Music</h3>
          <p class="mt-3 text-muted">
            Piano and composition — original pieces such as Natures Wedding and Battle Cry in C
            Minor, on SoundCloud.
          </p>
          <ul class="mt-6 space-y-2 text-spotlight/90">
            {
              music.slice(0, 3).map((item) => (
                <li>
                  <a class="text-gel hover:text-spotlight" href={`/music/${item.id}`}>
                    {item.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-8">
            <CtaLink href="/music" variant="secondary">Explore music</CtaLink>
          </div>
        </GlassPanel>
      </div>
    </div>
  </section>

  <section class="section-y border-b border-line" aria-labelledby="listen-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div id="listen-heading">
        <SectionHeader
          eyebrow="Listen & look"
          title="Around the web"
          support="Recordings, photos from the field, and a news story from Clearwater Marine Aquarium summer camp."
        />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <GlassPanel strong class="p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-gold">Music</p>
          <h3 class="mt-3 font-display text-2xl text-spotlight">SoundCloud</h3>
          <p class="mt-3 text-muted">
            Original piano pieces, including Natures Wedding, NASCAR, and Battle Cry in C Minor.
          </p>
          <div class="mt-8">
            <CtaLink href={socials.soundcloud.href} variant="secondary" external>
              Listen on SoundCloud
            </CtaLink>
          </div>
        </GlassPanel>
        <GlassPanel strong class="p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-gel">Photos</p>
          <h3 class="mt-3 font-display text-2xl text-spotlight">Gallery</h3>
          <p class="mt-3 text-muted">
            Belize assessments, CMA, and piano-adjacent pictures Jacob and a parent are comfortable
            sharing.
          </p>
          <div class="mt-8">
            <CtaLink href="/gallery" variant="secondary">Browse the gallery</CtaLink>
          </div>
        </GlassPanel>
        <GlassPanel strong class="p-8">
          <p class="text-sm uppercase tracking-[0.2em] text-gel">Press</p>
          <h3 class="mt-3 font-display text-2xl text-spotlight">Tampa Bay 28</h3>
          <p class="mt-3 text-muted">
            A story about Jacob’s friendship with Nicholas the dolphin at CMA summer camp.
          </p>
          <div class="mt-8">
            <CtaLink href="/news/nicholas-clearwater" variant="secondary">Read the note</CtaLink>
          </div>
        </GlassPanel>
      </div>
    </div>
  </section>

  <section class="section-y" aria-labelledby="news-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div id="news-heading">
        <SectionHeader
          eyebrow="Journal"
          title="Latest notes"
          support="Press, field notes, and new recordings."
          href="/news"
          linkLabel="All news →"
        />
      </div>
      <div class="mt-6 max-w-3xl">
        {
          news.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              href={`/news/${post.id}`}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
