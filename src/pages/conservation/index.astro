---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import OptimizedImg from '../../components/OptimizedImg.astro';
import { newestFirst } from '../../lib/contentSort';

const items = newestFirst(await getCollection('conservation'));
const featured = items[0];
const notes = items.slice(1);
---

<BaseLayout
  title="Conservation"
  description="Jacob Tindall’s notes on marine mammal conservation — Belize field work, dolphins, manatees, and volunteering at Clearwater Marine Aquarium."
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Marine mammals</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Conservation</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Notes on Belize manatee assessments, dolphins, and volunteering at Clearwater Marine Aquarium.
      Facts are checked against trusted sources, or left out.
    </p>

    {
      featured && (
        <a href={`/conservation/${featured.id}`} class="mt-12 block" aria-label={featured.data.title}>
          <GlassPanel strong class="overflow-hidden transition hover:border-gold">
            <div class="grid md:grid-cols-2">
              {featured.data.image && (
                <OptimizedImg
                  src={featured.data.image}
                  alt={featured.data.imageAlt || featured.data.title}
                  width={1080}
                  height={1080}
                  class="h-64 w-full object-cover object-top md:h-full"
                  sizes="(min-width: 768px) 50vw, 100vw"
                />
              )}
              <div class="p-8 md:p-10">
                <p class="text-sm uppercase tracking-[0.2em] text-gold">Latest story</p>
                <h2 class="mt-3 font-display text-3xl text-spotlight md:text-4xl">
                  {featured.data.title}
                </h2>
                <p class="mt-4 text-muted">{featured.data.summary}</p>
                <p class="mt-8 text-sm text-gel">Read the story →</p>
              </div>
            </div>
          </GlassPanel>
        </a>
      )
    }

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        notes.map((item) => (
          <a href={`/conservation/${item.id}`} aria-label={item.data.title}>
            <GlassPanel strong class="h-full overflow-hidden transition hover:border-gold">
              {item.data.image && (
                <OptimizedImg
                  src={item.data.image}
                  alt={item.data.imageAlt || item.data.title}
                  width={1080}
                  height={720}
                  class="h-52 w-full object-cover object-top"
                  sizes="(min-width: 768px) 50vw, 100vw"
                />
              )}
              <div class="p-8">
                {item.data.species && (
                  <p class="text-sm uppercase tracking-[0.2em] text-gel">{item.data.species}</p>
                )}
                <h2 class="mt-3 font-display text-3xl text-spotlight">{item.data.title}</h2>
                <p class="mt-3 text-muted">{item.data.summary}</p>
              </div>
            </GlassPanel>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
