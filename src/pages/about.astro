---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../lib/site';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing about page content');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">{site.jobTitle}</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">About</h1>
    <p class="mt-6 text-lg text-spotlight/90">{site.shortBio}</p>
    <div class="prose-site mt-10">
      <Content />
    </div>
    <p class="mt-8 text-sm text-muted">Listen and look:</p>
    <SocialLinks class="mt-3" />
    <p class="mt-8 text-sm text-muted">
      <a class="text-gel underline underline-offset-4" href="/gallery">
        Browse the gallery
      </a>
    </p>
  </section>
</BaseLayout>
