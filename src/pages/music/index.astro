---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlassPanel from '../../components/GlassPanel.astro';
import SoundCloudEmbed from '../../components/SoundCloudEmbed.astro';
import CtaLink from '../../components/CtaLink.astro';
import { soundcloud } from '../../lib/site';

const items = (await getCollection('music')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<BaseLayout
  title="Music"
  description="Jacob Tindall’s piano and composition notes — original pieces on SoundCloud."
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gold">Piano &amp; composition</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Music</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Original piano pieces Jacob has written and recorded. Play them here, or open SoundCloud for
      the full player.
    </p>
    <div class="mt-10 overflow-hidden rounded-sm border border-line">
      <SoundCloudEmbed />
    </div>
    <ul class="mt-6 space-y-2 text-spotlight/90">
      {
        soundcloud.tracks.map((track) => (
          <li>
            <a class="text-gel hover:text-spotlight" href={track.href} target="_blank" rel="noopener noreferrer">
              {track.title}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <CtaLink href={soundcloud.href} variant="secondary" external>
        Open SoundCloud
      </CtaLink>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        items.map((item) => (
          <a href={`/music/${item.id}`}>
            <GlassPanel strong class="h-full p-8 transition hover:border-gold">
              <p class="text-sm uppercase tracking-[0.2em] text-gel">{item.data.kind}</p>
              <h2 class="mt-3 font-display text-3xl text-spotlight">{item.data.title}</h2>
              <p class="mt-3 text-muted">{item.data.summary}</p>
            </GlassPanel>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
