---
import { site } from '../lib/site';
import CtaLink from './CtaLink.astro';

interface Props {
  support?: string;
}

const {
  support = 'Dolphins and manatees, piano and composition — a personal site for conservation and music.',
} = Astro.props;
---

<section class="relative min-h-[88vh] overflow-hidden" aria-labelledby="hero-heading">
  <div class="absolute inset-0" aria-hidden="true">
    <!-- Focal point is Jacob (left, mid): 22% 44%. Narrow viewports crop the right; wide ones crop top/bottom. -->
    <img
      src="/images/hero.jpg"
      alt=""
      width="1536"
      height="2048"
      class="absolute inset-0 h-full w-full object-cover object-[22%_44%]"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-ink/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/35 to-ink/30"></div>
    <div
      class="absolute inset-0 hidden bg-gradient-to-l from-ink via-ink/55 to-transparent md:block"
    >
    </div>
    <div
      class="absolute -right-24 top-16 h-80 w-80 rounded-full bg-gel/20 blur-3xl"
    >
    </div>
    <div
      class="absolute right-0 bottom-0 h-96 w-96 rounded-full bg-gold/10 blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative mx-auto flex min-h-[88vh] max-w-6xl items-end px-6 pb-10 pt-24 sm:pb-16 sm:pt-28 md:justify-end md:pb-24 md:pt-32"
  >
    <div class="max-w-xl md:text-right">
      <p class="fade-up text-sm uppercase tracking-[0.25em] text-gold">
        {site.jobTitle}
      </p>
      <h1
        id="hero-heading"
        class="fade-up-delay mt-3 font-display text-4xl leading-[0.92] text-spotlight sm:mt-4 sm:text-6xl md:text-7xl lg:text-8xl"
      >
        {site.name}
      </h1>
      <p class="fade-up-delay-2 mt-4 max-w-md text-base text-spotlight/90 sm:mt-5 sm:text-lg md:ml-auto">
        {support}
      </p>
      <div class="fade-up-delay-2 mt-7 flex flex-wrap gap-4 sm:mt-10 md:justify-end">
        <CtaLink href="/conservation">Conservation</CtaLink>
        <CtaLink href="/music" variant="secondary">Music</CtaLink>
      </div>
    </div>
  </div>
</section>
